{
  "expo": {
    "name": "الباحث العلمي AI",
    "slug": "albahith-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "albahith-ai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.albahith.ai"
    },
    "android": {
      "package": "com.albahith.ai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0B57D0"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "extra": {
      "eas": {
        "projectId": "606c60a7-f289-4232-87d9-36b7f6d"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
